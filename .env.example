# Copy to .env and adjust. docker compose reads .env automatically.

POSTGRES_DB=airgis
POSTGRES_USER=airgis
POSTGRES_PASSWORD=change-me

# Host port for PostGIS (connect psql or another database client here).
DB_PORT=5432
API_PORT=3000
WEB_PORT=8080

# Set to 1 to load the committed sample snapshot instead of the live feeds.
INGEST_OFFLINE=0
