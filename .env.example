# Copy to .env and adjust. docker compose reads .env automatically.

POSTGRES_DB=airgis
POSTGRES_USER=airgis
POSTGRES_PASSWORD=change-me

# Host port for PostGIS (connect QGIS or psql here).
DB_PORT=5432
API_PORT=3000

# Set to 1 to load the committed sample snapshot instead of the live feeds.
INGEST_OFFLINE=0
